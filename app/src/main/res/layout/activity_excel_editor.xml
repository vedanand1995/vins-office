<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Formula bar: cell ref + content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F5F5F5"
        android:padding="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cellRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="A1"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="6dp" />

        <EditText
            android:id="@+id/formulaBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="fx  =SUM(A1:A10)"
            android:textSize="13sp"
            android:inputType="text"
            android:singleLine="true"
            android:background="@android:drawable/edit_text" />
    </LinearLayout>

    <!-- Formatting toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button android:id="@+id/btnBold" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="B" android:textStyle="bold" />
            <Button android:id="@+id/btnItalic" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="I" android:textStyle="italic" />
            <Button android:id="@+id/btnUnderline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="U" />
            <Button android:id="@+id/btnFontPlus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="A+" />
            <Button android:id="@+id/btnFontMinus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="A-" />
            <Button android:id="@+id/btnAlignLeft" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="⬅" />
            <Button android:id="@+id/btnAlignCenter" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="⬌" />
            <Button android:id="@+id/btnAlignRight" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="➡" />
            <Button android:id="@+id/btnFillColor" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="🎨" />
            <Button android:id="@+id/btnTextColor" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="🅰" />
            <Button android:id="@+id/btnInsertRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="+R" />
            <Button android:id="@+id/btnDeleteRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="-R" />
            <Button android:id="@+id/btnInsertCol" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="+C" />
            <Button android:id="@+id/btnDeleteCol" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="44dp" android:text="-C" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="Loading..."
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <TableLayout
                android:id="@+id/grid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </ScrollView>
    </HorizontalScrollView>

    <!-- Sheet tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#ECEFF1">

        <LinearLayout
            android:id="@+id/sheetTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAddSheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="➕ Sheet" />

        <Button
            android:id="@+id/btnRenameSheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✏️ Rename" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💾 Save" />
    </LinearLayout>
</LinearLayout>

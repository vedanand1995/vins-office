<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vins Office"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Spinner
        android:id="@+id/fontSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnWord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📄 Word Document Open Karo" />

    <Button
        android:id="@+id/btnExcel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 Excel Sheet Open Karo" />

    <Button
        android:id="@+id/btnPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📕 PDF Open Karo" />

    <Button
        android:id="@+id/btnImportFont"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔤 Custom Font Import Karo (TTF)" />
</LinearLayout>
